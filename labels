import pandas as pd
data={
    'name':['anu','meera','rahul','aruyn'],
    'age':[20,21,22,22],
    'marks':[85,90,78,88]
}
df=pd.DataFrame(data)
print('Original dataframe:')
print(df)
print("\nstudents with marks greater than 80:")
print(df[df['marks']>80])
print("\nstudents whose age is 20:")
print(df[df['age']==20])
print("\nName and Marks columns")
print(df.loc[:,['name','marks']])
print("\nFirst two rows with name and marks:")
print(df.loc[0:1,['name','marks']])
